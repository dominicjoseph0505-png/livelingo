# LiveLingo Calling Server Environment Configuration

# Server Port and Host
PORT=3001
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LiveKit WebRTC Configuration
# Sign up at https://cloud.livekit.io or run a local LiveKit server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Sarvam AI — Indian language STT, TTS, and Translation
# Sign up at https://dashboard.sarvam.ai — free credits on signup
# Used for: Kannada (kn), Hindi (hi), Tamil (ta) STT + TTS + translation
SARVAM_API_KEY=

# Optional: External Cloud Translation / Speech API keys (non-Indian languages)
TRANSLATION_PROVIDER=mymemory
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
TRANSLATION_API_KEY=
SPEECH_API_KEY=
TTS_API_KEY=

# Production: set NODE_ENV=production and restrict CORS_ORIGINS to the Vercel origin + HTTPS app URL
# NODE_ENV=production
